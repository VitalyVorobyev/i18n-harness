{
  "name": "i18n-harness-ui",
  "private": true,
  "version": "0.2.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "audit": "bun audit --prod",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -- --no-default-features --features ollama",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitavision/ui": "^0.12.0",
    "@vitavision/workbench": "^0.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.6",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.2"
  }
}
