{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "i18n-harness",
  "identifier": "com.github.vitalyvorobyev.i18n-harness",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "i18n-harness",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "data:"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:*",
          "ws://localhost:*"
        ],
        "object-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "i18n-harness contributors",
    "copyright": "Copyright 2026 i18n-harness contributors. Apache-2.0.",
    "shortDescription": "Translate application text with a local language model.",
    "longDescription": "i18n-harness translates Qt Linguist, gettext and ICU message catalogs with a language model that runs on your computer, checks every translation for broken placeholders and markup, and writes the files back byte-for-byte outside the translations.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
